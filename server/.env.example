# Copy this file to .env and fill in your own values. .env is git-ignored.
# Special characters in the password must be percent-encoded in the URL
# (for example & becomes %26, * becomes %2A).

# Database the app uses when you run it locally
DATABASE_URL=postgres://pomodoro:YOUR_PASSWORD@localhost:5432/pomodoro_dev

# Database the tests use. The name must end in _test: the tests empty its tables.
TEST_DATABASE_URL=postgres://pomodoro:YOUR_PASSWORD@localhost:5432/pomodoro_test
